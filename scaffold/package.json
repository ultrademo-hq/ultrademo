{
  "name": "ultrademo-skill",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "Ultrademo: product videos written as code (HTML + GSAP on HyperFrames), made on your machine by your coding agent.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "check": "node scripts/setup.mjs --check",
    "telemetry": "node plan/telemetry.mjs",
    "update": "node plan/updates.mjs --force",
    "voice": "node --env-file-if-exists=.env scripts/voice.mjs"
  },
  "dependencies": {
    "@hyperframes/shader-transitions": "0.8.145",
    "hyperframes": "0.8.145",
    "playwright": "1.61.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  }
}
